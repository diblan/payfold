# Postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=payfold
POSTGRES_PORT=5432
POSTGRES_VOLUME=pg_data

# Timezone
TZ=Europe/Brussels

# RabbitMQ
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_VOLUME=rmq_data
RABBITMQ_EXCHANGE=billing.renewals
RABBITMQ_QUEUE=billing.renewals.main
RABBITMQ_ROUTINGKEY=renewal.requested

# App HTTP ports
PRODUCER_HTTP_PORT=8080
CONSUMER_HTTP_PORT=8081

# Upper bound of the consumer's host-port range: replicas from
# `docker compose up --scale renewal-consumer=N` bind CONSUMER_HTTP_PORT..this.
CONSUMER_HTTP_PORT_END=8083

# In-process listener concurrency (spring.rabbitmq.listener.simple.concurrency).
# Default 1 = the measured baseline; raise per run to measure the lever.
CONSUMER_LISTENER_CONCURRENCY=1

# Producer schedule
APP_SCHEDULECRON=0 0 3 * * *   # 03:00 local

# Mock bank (R23a): SEPA SDD settlement counterparty.
# Outcomes are deterministic from the debtor IBAN's last two chars (see
# docs/architecture.md#mock-bank); these envs configure only identity, delivery
# target, secret, and delays (fast for verify, visible for demo).
BANK_HTTP_PORT=8085
BANK_ID=bank-a
BANK_WEBHOOK_SECRET=payfold-dev-secret
BANK_SETTLEMENT_DELAY_SECONDS=2
BANK_CHARGEBACK_LAG_SECONDS=5
# Second bank instance (R23e): same image, slow profile — the multi-bank
# proof. bank-a serves BE+FR, bank-b serves NL+IE (per-country routing).
BANK_B_HTTP_PORT=8086
BANK_B_WEBHOOK_SECRET=payfold-dev-secret-b
BANK_B_SETTLEMENT_DELAY_SECONDS=8
BANK_B_CHARGEBACK_LAG_SECONDS=10
# Card scheme instance (R23f): the same counterparty image with
# BANK_SCHEME=card — sync auth verdict from the card token's last two
# chars, async settlement through the same webhook spine.
CARDNET_HTTP_PORT=8087
CARDNET_WEBHOOK_SECRET=payfold-dev-secret-card
CARDNET_SETTLEMENT_DELAY_SECONDS=1
CARDNET_CHARGEBACK_LAG_SECONDS=5
# cardnet absorbs ~80% of submissions plus their webhook deliveries; extra
# uvicorn workers keep the mock counterparty off the critical path at high
# consumer concurrency (R32/D19)
CARDNET_WORKERS=4
# Webhook delivery envelope shared by all counterparty instances (R23f): the
# bounded retry must outlive a chaos-scene consumer outage, or gave-up
# notifications strand collections in submitted (recovery story: R28).
BANK_WEBHOOK_RETRY_MAX_ATTEMPTS=8
BANK_WEBHOOK_RETRY_BACKOFF_SECONDS=2
# Recovery sweeper (R28/D18): payments stuck submitted older than the stale
# threshold are re-queried at the owning counterparty (GET /collections/{id});
# a stored terminal outcome is synthesized into settlement_inbox, a 404 (bank
# restart amnesia) is resubmitted. Compose values are verify/demo-fast; the
# application default (300 s) exceeds the worst-case delivery envelope.
RECOVERY_STALE_AFTER_SECONDS=30
RECOVERY_SWEEP_INTERVAL_MS=10000
# Dunning grace windows (R26a/D16, enforced since R26c): scaled seconds per
# class — how long a past_due subscription may wait before the expiry pass
# cancels it. Retriable grace is 120 (not 60) so bounded exhaustion at the
# compose cadence (~40-75 s after the first failure) demonstrably wins the
# race for the 99 cohort; expiry stays armed as its class-blind backstop (D21).
DUNNING_RETRIABLE_GRACE_SECONDS=120
DUNNING_HARD_FAIL_GRACE_SECONDS=60
DUNNING_DISPUTE_GRACE_SECONDS=60
# re-collection delay + sweep cadence, compose-scaled (D20); attempts are
# bounded — base + re-collections stop at DUNNING_MAX_ATTEMPTS, then the
# sweeper cancels (R26c/D21: application default 4, compose 3).
DUNNING_RETRY_DELAY_SECONDS=15
DUNNING_SWEEP_INTERVAL_MS=10000
DUNNING_MAX_ATTEMPTS=3
# Deterministic delivery-loss modeling: share of each cohort seeded with the
# suffix-94 "silent bank" rule (classifies normally, never notifies) — these
# payments can only complete through the recovery sweeper.
SEED_SDD_SILENT_PERCENT=2
SEED_CARD_SILENT_PERCENT=2
# suffix-95 recoverable share (R26b)
SEED_SDD_RETRY_PERCENT=2
SEED_CARD_RETRY_PERCENT=2
# Card-cohort rule-bearing token share (deterministic, cycling
# insufficient_funds / do_not_honor / fraud_dispute).
SEED_CARD_RULE_PERCENT=4
# Seeded payment-method mix (R23b): SEED_SDD_PERCENT of customers pay by SDD
# (deterministic: customer number modulo 100), of which SEED_SDD_RULE_PERCENT
# carry a rule-bearing IBAN suffix (cycling AM04/AC04/MD01/MD06).
SEED_SDD_PERCENT=20
SEED_SDD_RULE_PERCENT=4

# Local observability (R21): Prometheus + provisioned Grafana.
# Grafana serves the pipeline dashboard read-only to anonymous viewers;
# the admin login below is only needed to edit panels.
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=payfold

# Seed data
# Customers created on first boot; each gets one subscription due that day, so this
# value sets the size of the day's renewal batch. The seeder tops up to this count
# and skips when the customer table already meets it. Override per run without
# editing this file:  SEED_CUSTOMERS=100000 docker compose up -d --build
SEED_CUSTOMERS=15000
